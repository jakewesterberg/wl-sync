		(at 367.23 47)
		(descr "Through hole straight pin header, 2x03, 2.54mm pitch, double rows")
		(tags "Through hole pin header THT 2x03 2.54mm double row")
		(property "Reference" "J28"
			(at 1.275 -2.57 0)
			(layer "F.SilkS")
			(uuid "0576f958-e8a4-48fe-9ba5-0fe766d54cd1")
			(effects
				(font
					(size 0.8 0.8)
					(thickness 0.13)
				)
			)
		)
		(property "Value" "Misc analog input 1 (panel BNC, /1//2 selectable) -- /1//2 shunt header, BOTH legs (fix round 3, task-10b-report.md): column A (pins 1,3,5) = SIGNAL leg raw/div/mid, column B (pins 2,4,6) = SHIELD leg raw/div/mid -- confirmed 2.54mm-pitch adjacent pairs on the REAL PinHeader_2x03_P2.54mm_Vertical footprint (kicad-cli fp export svg + kicad_pcb.footprint_pads(), not just the schematic symbol -- fix round 2's Conn_02x03_Top_Bottom/row assignment assumed a pin adjacency this footprint does not actually have). Populate with ONE 2-GANG SHORTING BLOCK spanning both columns at the same row-pair -- pins 1-3 + 2-4 for x1 (direct), pins 3-5 + 4-6 for x2 (divider tap) -- NEVER two independent 1-gang shunts: that is the exact defect this header replaces (fix round 1 left it physically possible for the two legs' own jumpers to disagree; a mechanically-ganged 2-gang block makes disagreement physically impossible instead of merely documented against)."
			(at 0 0 0)
			(layer "F.Fab")
			(hide yes)
			(uuid "363a06af-16cc-40e5-a6a9-b50a63d4bd85")
