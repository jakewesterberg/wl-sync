		(effects (font (size 1.27 1.27)))
		(uuid "e289ad44-0da4-4fde-8327-0f5c6a819ced")
	)
	(text "and injecting ~7mA into an unpowered pad whenever this board is on and the sync"
		(at 179.07 351.79 0)
		(effects (font (size 1.27 1.27)))
		(uuid "94dc84dc-f727-4d44-8f72-c156d2cc6680")
	)
