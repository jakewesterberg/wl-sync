	(text "TWO BUFFER OUTPUTS PER OPTOCOUPLER LED (finding F1b, 2026-08-16)."
		(at 560.07 379.73 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4b723cd4-6356-4b90-a2c8-245490f0e3ad")
	)
	(text ""
		(at 560.07 384.81 0)
		(effects (font (size 1.27 1.27)))
		(uuid "bde635e4-2185-41b7-b9f3-de59f5e59bb2")
	)
	(text "These four packages carry the SECOND output of every LED pair. They exist"
		(at 560.07 389.89000000000004 0)
		(effects (font (size 1.27 1.27)))
		(uuid "208e10f8-7f1e-41a7-b4e5-ac3f34ef1986")
	)
	(text "because the LED series resistor had to fall from 430R to 249R -- at 430R the"
		(at 560.07 394.97 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4384d0a4-606e-4338-88a4-875f22bc088f")
	)
	(text "LEDs were never guaranteed to switch (~5mA worst case against a 7.0mA I_FH"
		(at 560.07 400.05 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ea5bcbc0-1f2d-4c2b-9188-fbd63c29a1f5")
	)
	(text "minimum, because the +5V rail reaches them through F4 and D3 and the original"
		(at 560.07 405.13 0)
		(effects (font (size 1.27 1.27)))
		(uuid "2d60fdc9-60ce-4f3d-8980-d83d4a41a58f")
	)
	(text "sizing used a nominal 5.00V and a TYPICAL V_F) -- and 249R draws ~12.7mA,"
		(at 560.07 410.21000000000004 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c470b8e3-e4d4-429a-857c-2c62824930fc")
	)
	(text "which one AHCT541 output cannot sink. Neither value is shippable alone."
		(at 560.07 415.29 0)
		(effects (font (size 1.27 1.27)))
		(uuid "555afbca-5fd9-4437-a942-b6835fd984d8")
	)
	(text ""
		(at 560.07 420.37 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1afaed14-85af-4918-a509-e940e623072f")
	)
	(text "It also fixes a PACKAGE limit no per-pin check can see. AHCT541's GND-pin"
		(at 560.07 425.45000000000005 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a7811a7a-26ed-4c3a-83ef-815e8e7fe3ff")
	)
	(text "absolute maximum is 75mA; U8 and U9 drive eight LEDs each; the drive is"
		(at 560.07 430.53000000000003 0)
		(effects (font (size 1.27 1.27)))
		(uuid "83572321-3c9b-41d4-98e7-8a3991a4e4d6")
	)
	(text "active-low and the event bus idles at 0x0000, so sixteen LEDs are lit"
		(at 560.07 435.61 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c9b86c33-1ee5-478e-89c6-e6beb1723bae")
	)
	(text "CONTINUOUSLY. At 249R unparalleled that is ~101mA through one ground pin."
		(at 560.07 440.69 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e209eeae-a2b7-4397-adc1-7cf1c341a6bb")
	)
	(text "Paralleled it is ~51mA, and each output pin sees ~6.3mA of a 7.5mA budget."
		(at 560.07 445.77000000000004 0)
		(effects (font (size 1.27 1.27)))
		(uuid "b046660f-9d46-412c-8254-649696ede54d")
	)
	(text ""
		(at 560.07 450.85 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f071d82d-79ae-48d4-b477-b46596441c12")
	)
	(text "  U70  doubles U8   -- EVT_D0_BUF .. EVT_D7_BUF"
		(at 560.07 455.93 0)
		(effects (font (size 1.27 1.27)))
		(uuid "76fb6dc8-9778-4b2f-a461-75d93c144506")
	)
	(text "  U71  doubles U9   -- EVT_D8_BUF .. EVT_D15_BUF"
