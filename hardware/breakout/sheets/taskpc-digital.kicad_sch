	)
	(text "a real driver elsewhere in this project (Task 10d's LM339 for the first three,"
		(at 179.07 295.91 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4e58e322-e3a1-4ddd-b3cb-b760f670b437")
	)
	(text "Task 11's ACSL-6420 for RHS_STIM_OUT) -- no PWR_FLAGs remain on this sheet for"
		(at 179.07 300.99 0)
		(effects (font (size 1.27 1.27)))
		(uuid "64f9c13b-ba9e-434f-88a4-194593a83abc")
	)
	(text "any of them. See _place_outbound()'s own docstring ('TASK 11 UPDATE') for the"
		(at 179.07 306.07 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6b3564af-945b-4c7d-9cda-45ad62419cde")
	)
	(text "deletion history."
