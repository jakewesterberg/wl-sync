		(effects (font (size 1.27 1.27)))
		(uuid "10189bbe-3f1e-4cd7-9731-9c3d1669c348")
	)
	(text "class). Also places the recording NI's own Connector 1 (digital) -- Connector 0"
		(at 340.36 35.56 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d1ec01ea-12ea-4c36-93be-19d530f87eb3")
	)
	(text "(analog) was already placed by Task 10b on analog-ni.kicad_sch; not duplicated."
