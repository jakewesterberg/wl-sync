		(effects (font (size 1.27 1.27)))
		(uuid "b0a1cc2f-ea2f-4693-b608-197452c5d59a")
	)
	(text "RWD_DLVR, STIM_TRIG_BUF, RHS_STIM_OUT, PD1_COMP, PD2_COMP -- 24 total, filling"
