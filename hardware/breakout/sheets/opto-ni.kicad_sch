	(text "Opto-NI (Task 11) -- 24 digital channels, DGND domain -> NI-isolated domain,"
		(at 340.36 20.32 0)
		(effects (font (size 1.27 1.27)))
		(uuid "04525c43-452c-4f8f-82e2-b5bdb0f75a0b")
	)
	(text "via six Broadcom ACSL-6400 (quad, all-in-one, 15 MBd logic-output optocoupler,"
		(at 340.36 25.4 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d4065e68-b669-47dd-82a9-da17f01e3713")
	)
	(text "16-pin SOIC -- NOT phototransistor, matching the mule's own validated part"
