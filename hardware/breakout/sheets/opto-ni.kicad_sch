		(effects (font (size 1.27 1.27)))
		(uuid "eb7c107c-2480-4cd5-9366-54ef3f7b1647")
	)
	(text ""
		(at 340.36 45.72 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ffb5d99b-3fec-4dbe-97c6-2d47e2674fad")
	)
	(text "Channels: EVT_D0_BUF..EVT_D15_BUF (16), EVT_STROBE_BUF, BARCODE_PI, RWD_CMD_BUF,"
