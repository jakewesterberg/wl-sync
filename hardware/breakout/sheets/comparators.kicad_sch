	(text "Comparators (Task 10d) -- one LM339 quad comparator. Three channels used:"
		(at 180.34 20.32 0)
		(effects (font (size 1.27 1.27)))
		(uuid "b0ee8486-ac8e-4fc4-af5b-48ff1e7a1b37")
	)
	(text "A_PD1->PD1_COMP, A_PD2->PD2_COMP, A_ACC->ACC_TRIG (Task 10a's own sources,"
		(at 180.34 25.4 0)
		(effects (font (size 1.27 1.27)))
		(uuid "682d988a-6a74-49e5-a435-01d9888a7968")
	)
	(text "spec Sec.6.5). Fourth (A_MISC1) brought out, unpopulated -- see below."
		(at 180.34 30.48 0)
		(effects (font (size 1.27 1.27)))
		(uuid "50167d5e-a68b-4c89-bf74-af972b698c21")
	)
	(text ""
		(at 180.34 35.56 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a8899912-33e1-4b76-a72e-43de81b7dedd")
	)
	(text "Every '+' (non-inverting) input takes its own channel's analog source (through"
		(at 180.34 40.64 0)
		(effects (font (size 1.27 1.27)))
		(uuid "2a008fbf-ea64-4e28-b6a9-4529063b88ae")
	)
	(text "a 10k series resistor on populated channels -- see the hysteresis note below);"
		(at 180.34 45.72 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8dbebd55-c9cd-43ba-aa6e-759e81255eb7")
	)
	(text "every '-' (inverting) input takes a fixed threshold from one of the MCP4728's"
		(at 180.34 50.8 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1cabd342-baf9-4da8-8932-00674df75952")
	)
	(text "four VOUT channels, direct wire. Output is open-collector, pulled up to +3V3"
		(at 180.34 55.88 0)
		(effects (font (size 1.27 1.27)))
		(uuid "da154776-cd8f-4736-9055-1990d11283bf")
	)
	(text "(never +5V -- see below) and fed back 1M to the '+' node for hysteresis."
		(at 180.34 60.96 0)
		(effects (font (size 1.27 1.27)))
		(uuid "89d745a2-08f2-48d6-a754-dd1bc687f3a8")
	)
	(text ""
		(at 180.34 66.03999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "760e2b42-ca7f-48e3-952c-66026d4de52f")
	)
	(text "All three outputs (PD1_COMP/PD2_COMP/ACC_TRIG) reach the sync module's own GPIO"
		(at 180.34 71.12 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6a0cea1e-7396-47ba-a524-3c8fe7c57af1")
	)
	(text "DIRECTLY (pi-interface.kicad_sch, Task 9, GPIO20/21/25 -- 'direct' kind, no"
		(at 180.34 76.2 0)
		(effects (font (size 1.27 1.27)))
		(uuid "291c9ced-9a2a-4078-a22f-4c529da23f4f")
	)
	(text "protection in between) and the task PC's own outbound buffer"
		(at 180.34 81.28 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8ad408a4-a509-4e5d-ad38-68095a95cd75")
	)
	(text "(taskpc-digital.kicad_sch, Task 8) -- confirmed by reading both sheets' own"
		(at 180.34 86.36000000000001 0)
		(effects (font (size 1.27 1.27)))
		(uuid "099e3133-837d-4a8a-9ac0-6048264c24af")
	)
	(text "committed source before writing this one, not assumed."
		(at 180.34 91.44 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a13081b5-edb7-4829-88ee-94a8fe512572")
	)
	(text "PULL-UPS GO TO +3V3, NEVER +5V -- THE DESTROY-HARDWARE CONSTRAINT. All three"
		(at 180.34 95.25 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3ef2d9e3-0857-455a-851f-732a17ac34ab")
	)
	(text "comparator outputs wire DIRECTLY to the sync module's own GPIO20/21/25, which"
		(at 180.34 100.33 0)
		(effects (font (size 1.27 1.27)))
		(uuid "56631e62-e46f-413b-b419-e565ddb709ec")
	)
	(text "is 3.3V and NOT 5V tolerant. Pulled to +5V, an open-collector HIGH would put 5V"
		(at 180.34 105.41 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d28d5a86-25dc-4b9b-b365-6dfddf243494")
	)
	(text "straight onto an unprotected 3.3V input and destroy the module."
		(at 180.34 110.49 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1154a207-75da-4a83-b890-6dde9b4e8e98")
	)
	(text ""
		(at 180.34 115.57 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1ff35def-8039-42b2-8f24-d60273e987bc")
	)
	(text "Pulled to +3V3 the module path is safe BY CONSTRUCTION, and the task-PC path"
