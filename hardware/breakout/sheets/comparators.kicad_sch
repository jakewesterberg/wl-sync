	(text "Comparators (Task 10d) -- one LM339 quad comparator. Three channels used:"
		(at 180.34 20.32 0)
		(effects (font (size 1.27 1.27)))
		(uuid "847ccce6-bfbf-4514-a848-b42960d4e087")
	)
	(text "A_PD1->PD1_COMP, A_PD2->PD2_COMP, A_ACC->ACC_TRIG (Task 10a's own sources,"
		(at 180.34 25.4 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d0697c73-b125-4364-be4d-220a879794d2")
	)
	(text "spec Sec.6.5). Fourth (A_MISC1) brought out, unpopulated -- see below."
		(at 180.34 30.48 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e10983d7-9343-4bb8-88cb-9215afc10fd4")
	)
	(text ""
		(at 180.34 35.56 0)
		(effects (font (size 1.27 1.27)))
		(uuid "235807a2-3fc3-43ea-86e1-42e63d78343a")
	)
	(text "Every '+' (non-inverting) input takes its own channel's analog source (through"
		(at 180.34 40.64 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1d93f1a0-3d6b-4b33-9bd7-2902d83d9634")
	)
	(text "a 10k series resistor on populated channels -- see the hysteresis note below);"
		(at 180.34 45.72 0)
		(effects (font (size 1.27 1.27)))
		(uuid "eba89cc5-4a96-4cc2-b1f5-0378b741321e")
	)
	(text "every '-' (inverting) input takes a fixed threshold from one of the MCP4728's"
		(at 180.34 50.8 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ff858d34-2596-486c-a82a-bd8c35945885")
	)
	(text "four VOUT channels, direct wire. Output is open-collector, pulled up to +3V3"
		(at 180.34 55.88 0)
		(effects (font (size 1.27 1.27)))
		(uuid "0bc2742b-f4d4-494b-ba2b-41adaa4033c0")
	)
	(text "(never +5V -- see below) and fed back 1M to the '+' node for hysteresis."
		(at 180.34 60.96 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c7a9f0e9-5e56-4d09-a579-60c3459cab94")
	)
	(text ""
		(at 180.34 66.03999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8fc08b33-4b29-4e56-ba20-e75736f9c914")
	)
	(text "All three outputs (PD1_COMP/PD2_COMP/ACC_TRIG) reach the sync module's own GPIO"
		(at 180.34 71.12 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c5da9b22-845f-4498-83a1-5c1cbd959144")
	)
	(text "DIRECTLY (pi-interface.kicad_sch, Task 9, GPIO20/21/25 -- 'direct' kind, no"
		(at 180.34 76.2 0)
		(effects (font (size 1.27 1.27)))
		(uuid "042f483b-5fb0-41a3-86bc-6da2be02c7ca")
	)
	(text "protection in between) and the task PC's own outbound buffer"
		(at 180.34 81.28 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3d4b9486-dc7d-45d9-ae11-59946154e5da")
	)
	(text "(taskpc-digital.kicad_sch, Task 8) -- confirmed by reading both sheets' own"
		(at 180.34 86.36000000000001 0)
		(effects (font (size 1.27 1.27)))
		(uuid "0263b4db-906d-4642-9a3b-273ece46fd89")
	)
	(text "committed source before writing this one, not assumed."
		(at 180.34 91.44 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d75e9f6a-f289-4f9a-9c33-a7b523cac96e")
	)
	(text "PULL-UPS GO TO +3V3, NEVER +5V -- THE DESTROY-HARDWARE CONSTRAINT. All three"
		(at 180.34 95.25 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f3de8860-4c4b-47c9-980f-32b1887392aa")
	)
	(text "comparator outputs wire DIRECTLY to the sync module's own GPIO20/21/25, which"
		(at 180.34 100.33 0)
		(effects (font (size 1.27 1.27)))
		(uuid "bb422994-3236-4ea0-b992-b55df6acc975")
	)
	(text "is 3.3V and NOT 5V tolerant. Pulled to +5V, an open-collector HIGH would put 5V"
		(at 180.34 105.41 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c6fa77f7-4a35-48f5-a699-470e1ece2090")
	)
	(text "straight onto an unprotected 3.3V input and destroy the module."
		(at 180.34 110.49 0)
		(effects (font (size 1.27 1.27)))
		(uuid "551fa365-90f8-456a-8f97-84c476c96e07")
	)
	(text ""
		(at 180.34 115.57 0)
		(effects (font (size 1.27 1.27)))
		(uuid "912990d3-50bc-48d7-9f72-43e43879b8b6")
	)
	(text "Pulled to +3V3 the module path is safe BY CONSTRUCTION, and the task-PC path"
		(at 180.34 120.65 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6d659c97-0512-485e-bf52-26a378fef759")
	)
	(text "still works: Task 8's own outbound SN74HCT541PW buffer runs on +5V, and"
		(at 180.34 125.73 0)
		(effects (font (size 1.27 1.27)))
		(uuid "b461dc3c-1a90-400c-a891-f52c95f5efaa")
	)
	(text "74HCT's own input threshold is TTL-compatible (~2.0V min, not a fraction of"
		(at 180.34 130.81 0)
		(effects (font (size 1.27 1.27)))
		(uuid "fb8c2e42-8c13-483d-8119-7f37c9ecf15b")
	)
	(text "its own 5V supply) -- a 3.3V high from this sheet still reads as a valid logic"
