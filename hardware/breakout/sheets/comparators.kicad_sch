		(uuid "78adbe56-9ae6-46b1-9c8f-f497b402018b")
	)
	(text "= V_DAC*(1+k) - Vout*k, k=Rs/Rf=10k/1M=0.01. Rising (Vout~0V): 1.01*V_DAC."
