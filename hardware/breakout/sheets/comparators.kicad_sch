		(effects (font (size 1.27 1.27)))
		(uuid "8c7554f9-ae02-4f28-afe1-bdc1ffde4769")
	)
	(text "already exists, not on this sheet."
		(at 180.34 146.05 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8832bad9-5c85-48d5-8379-b838615326e8")
	)
	(text ""
		(at 180.34 151.13 0)
		(effects (font (size 1.27 1.27)))
		(uuid "5408ca10-15b4-4cba-ab45-b9dea1f5ad58")
	)
	(text "This is exactly the class of error that passes kicad-cli sch erc (a resistor"
		(at 180.34 156.21 0)
		(effects (font (size 1.27 1.27)))
		(uuid "414a0e0c-fbfb-404c-be72-e7d869372dbe")
	)
	(text "to a valid, correctly-typed power net is not an ERC violation regardless of"
