	(text "Four chassis fan headers (spec Sec.9.5, added 2026-08-15): standard PC 3-pin"
		(at 439.42 160.02 0)
		(effects (font (size 1.27 1.27)))
		(uuid "9d41ea16-3922-4396-a8bf-6cf729fd54eb")
	)
	(text "fan pinout, 2.54mm -- pin 1 GND, pin 2 +12V, pin 3 tach."
		(at 439.42 165.10000000000002 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ca41bf2a-059f-48b5-ad03-2ccad74aab9d")
	)
	(text "PIN 3 (TACH) IS A DELIBERATE NO-CONNECT -- DO NOT DELETE THE PIN. Power-only"
		(at 439.42 170.18 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1bfbdbc0-5a4f-4634-9965-32fae53b4c2c")
	)
	(text "was chosen because the sync module's GPIO is full at 26 of 28; keeping the"
		(at 439.42 175.26000000000002 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f2ba753d-9c24-47d8-88f2-b4b40862604c")
	)
	(text "third pin lets a 3- or 4-pin Noctua-class plug seat with no adapter, and makes"
		(at 439.42 180.34 0)
		(effects (font (size 1.27 1.27)))
		(uuid "0d365f9b-4b22-4ad3-bbe4-d380a5763cbd")
	)
	(text "adding tach later a wire change, not a connector change."
		(at 439.42 185.42000000000002 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c8a5499a-4f7e-44b9-9724-d32736bf9b71")
	)
	(text "FAN_12V/FAN_RTN are dedicated nets, never AGND/DGND directly: a fan is a"
		(at 439.42 190.5 0)
		(effects (font (size 1.27 1.27)))
		(uuid "90cfad32-e884-453f-8439-06bab881a6d6")
	)
	(text "commutating switching load, and its ~240mA through the analog ground would"
		(at 439.42 195.58 0)
		(effects (font (size 1.27 1.27)))
		(uuid "55e4511f-06ce-4887-8401-c54bbc7c58c2")
	)
	(text "contradict rejecting digital isolators for an RF carrier (spec Sec.2 decision"
		(at 439.42 200.66000000000003 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a5a071e5-c62b-4b2c-9e4a-3be78431c2e0")
	)
	(text "3) and on-board switchers for consistency (spec Sec.8). FAN_12V derives from"
		(at 439.42 205.74 0)
		(effects (font (size 1.27 1.27)))
		(uuid "81f14bbf-65c3-4b7d-8ddb-efebd0ff2959")
	)
	(text "+12V through F1 (polyfuse, 1206L050/15YR: 500mA hold / 1A trip) so a stalled"
		(at 439.42 210.82 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3be4b3e8-f366-4efa-8b02-a3bb40813744")
	)
	(text "or shorted fan cannot pull down the rails the analog section depends on."
		(at 439.42 215.9 0)
		(effects (font (size 1.27 1.27)))
		(uuid "5a68089b-bdc2-49a6-b8fd-81907b68b262")
	)
	(text "FAN_RTN joins DGND at exactly one point (NT2), mirroring how AGND/DGND join"
		(at 439.42 220.98000000000002 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f0a6d604-1b42-464f-bcc2-62710753470b")
	)
	(text "at J1 -- so FAN_RTN reaches AGND too, but only transitively, through NT2 then"
		(at 439.42 226.06 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8fd3ad23-02d0-4477-bed6-5f88dc891f4a")
	)
	(text "NT1, never by a direct shared pin."
		(at 439.42 231.14000000000001 0)
		(effects (font (size 1.27 1.27)))
		(uuid "034b3e11-a0cd-4be2-9d5a-b3fcb25882db")
	)
