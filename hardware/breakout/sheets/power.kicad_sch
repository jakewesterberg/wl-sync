	(text "FAN_RTN joins DGND at exactly one point (NT2), mirroring how AGND/DGND join"
		(exclude_from_sim no)
		(at 439.42 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1fbcfffd-eca0-434a-93d6-366f8e2e5df4")
	)
	(text "adding tach later a wire change, not a connector change."
		(exclude_from_sim no)
		(at 439.42 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2c2907bb-356b-4dc4-bb1c-cc1bce081ebb")
	)
	(text "contradict rejecting digital isolators for an RF carrier (spec Sec.2 decision"
		(exclude_from_sim no)
		(at 439.42 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "34510e40-5fe7-4310-a823-99a876c32376")
	)
	(text "was chosen because the sync module's GPIO is full at 26 of 28; keeping the"
		(exclude_from_sim no)
		(at 439.42 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "395e68cb-d73d-4205-936d-d7882bd7a7f4")
	)
	(text "PIN 3 (TACH) IS A DELIBERATE NO-CONNECT -- DO NOT DELETE THE PIN. Power-only"
		(exclude_from_sim no)
		(at 439.42 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "56116009-e81e-42f5-a6db-67d811228c32")
	)
	(text "3) and on-board switchers for consistency (spec Sec.8). FAN_12V derives from"
		(exclude_from_sim no)
		(at 439.42 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "652dee71-c0c7-4250-9545-62ffd2f9d762")
	)
	(text "commutating switching load, and its ~240mA through the analog ground would"
		(exclude_from_sim no)
		(at 439.42 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6b4e0f4d-8e5d-4e57-a31e-66180c0ec0cf")
	)
	(text "Four chassis fan headers (spec Sec.9.5, added 2026-08-15): standard PC 3-pin"
		(exclude_from_sim no)
		(at 439.42 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "717979f9-744e-4655-a018-704c9dfe0225")
	)
	(text "at J1 -- so FAN_RTN reaches AGND too, but only transitively, through NT2 then"
		(exclude_from_sim no)
		(at 439.42 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "91d9e66c-c98e-44e5-ac81-b40d54d7c03b")
	)
	(text "or shorted fan cannot pull down the rails the analog section depends on."
		(exclude_from_sim no)
		(at 439.42 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "986baa13-27c8-4392-b7df-e3a17c1a905a")
	)
	(text "NT1, never by a direct shared pin."
		(exclude_from_sim no)
		(at 439.42 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9bf2d024-205f-44bd-aeb9-ae104bbc5955")
	)
	(text "third pin lets a 3- or 4-pin Noctua-class plug seat with no adapter, and makes"
