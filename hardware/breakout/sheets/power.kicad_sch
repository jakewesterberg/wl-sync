	(text "PANEL-INSTRUMENTATION ADDITIONS (2026-08-15, spec Sec.9.8) -- five things a"
		(at 400.05 449.58 0)
		(effects (font (size 1.27 1.27)))
		(uuid "bb9aeccd-b674-4b2a-b13e-ff2b557b6f7d")
	)
	(text "rack instrument needs that this board lacked; all landing on this sheet:"
		(at 400.05 454.65999999999997 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6d2f3416-6ec8-4462-8b98-d9ea787639fb")
	)
	(text ""
		(at 400.05 459.74 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1ac28ee5-e378-4c47-bdaf-62f744763858")
	)
	(text "1. Chassis earth stud (J56): a mounting point the cage-to-rack bond (Sec.5.6)"
		(at 400.05 464.82 0)
		(effects (font (size 1.27 1.27)))
		(uuid "89c0992b-36b6-4e9b-b79d-86af40999feb")
	)
	(text "   can land on. CHASSIS_GND joins DGND at exactly one point (NT3), mirroring"
		(at 400.05 469.9 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4f71398c-db78-4a30-b7fd-56852820cd75")
	)
	(text "   FAN_RTN's own NT2 -- reaches the board's single star point transitively."
		(at 400.05 474.97999999999996 0)
		(effects (font (size 1.27 1.27)))
		(uuid "b16489f0-ab14-4de7-be13-79f567fdd5e2")
	)
	(text ""
		(at 400.05 480.06 0)
		(effects (font (size 1.27 1.27)))
		(uuid "9140760e-6a68-4c7a-8851-0d44e7f807be")
	)
	(text "2. Power-good LED per rail (D40/D41/D42, +12V/-12V/+5V): a failed rail is"
		(at 400.05 485.14 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1a5696de-c393-4339-90ff-6c3f37ba799e")
	)
	(text "   otherwise invisible until the data is wrong. ~4.5mA each, negligible"
		(at 400.05 490.21999999999997 0)
		(effects (font (size 1.27 1.27)))
		(uuid "01919cc7-31e9-4366-ae6d-f9aa8ea8aca0")
	)
	(text "   against any rail's own real budget."
		(at 400.05 495.29999999999995 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8ebcb4ce-59ce-4c72-bf90-d3fd8563109c")
	)
	(text ""
		(at 400.05 500.38 0)
		(effects (font (size 1.27 1.27)))
		(uuid "b54e40a8-0e5f-4dee-96f4-97912a93ec4d")
	)
	(text "3. Rail test points (TP1-7): one per voltage rail (+12V/-12V/+5V/+3V3/"
		(at 400.05 505.46 0)
		(effects (font (size 1.27 1.27)))
		(uuid "74c24861-81e9-4d88-9e84-92f34cb4cc72")
	)
	(text "   ISO_P12/ISO_N12) PLUS one on INTAN_GND -- the isolated rails' own"
		(at 400.05 510.53999999999996 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d367329f-4dd9-41ae-a54e-db83780ec3b7")
	)
	(text "   reference, without which ISO_P12/ISO_N12 cannot be measured at all"
		(at 400.05 515.62 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a8e74fce-1079-4869-84fc-408ca02aedf6")
	)
	(text "   (INTAN_GND is galvanically separate from AGND/DGND, Sec.5.3/5.5)."
		(at 400.05 520.7 0)
		(effects (font (size 1.27 1.27)))
		(uuid "af87e3fb-2785-4783-be4e-c441dd984f56")
	)
	(text "   AGND/DGND themselves are not dedicated here -- already trivially"
		(at 400.05 525.78 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3aac1740-85fe-422b-938e-11567a00896c")
	)
	(text "   probable at any of this sheet's own many ground pads."
		(at 400.05 530.86 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6ec11588-cd9a-413b-b02c-0a698a471d2f")
	)
	(text ""
		(at 400.05 535.9399999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "35dc4950-a25e-4f5e-839c-078a183a6655")
	)
	(text "4. Main input fusing (F2/F3/F4, +12V/-12V/+5V): the fans already had a"
		(at 400.05 541.02 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d0945ad2-8243-4c7e-a41b-5511d85c3e62")
	)
	(text "   polyfuse (F1); the main rails did not. Same real part (Littelfuse"
		(at 400.05 546.1 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e51432b4-989d-466b-9921-eed670683cb7")
	)
	(text "   1206L050/15YR) as F1, placed upstream of each rail's own existing"
		(at 400.05 551.18 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4aa9647f-e0f7-4a0e-8bd9-8c04fc407eee")
	)
	(text "   reverse-polarity diode (_place_inlet()) -- see that function's own"
		(at 400.05 556.26 0)
		(effects (font (size 1.27 1.27)))
		(uuid "0dba1524-8edf-4e91-9dea-0205a838dab7")
	)
	(text "   docstring for the sizing and the +-12V margin caveat."
		(at 400.05 561.34 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3662b470-6f07-4601-bb1d-8e90daffa848")
	)
	(text ""
		(at 400.05 566.42 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1058beab-c5d1-472d-9adf-fa3659c9a88d")
	)
	(text "(Item 5, barcode heartbeat LED, is not on this sheet -- it lives on"
		(at 400.05 571.5 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ca9166a3-0431-4066-ae91-4b47611a6832")
	)
	(text "pi-interface.kicad_sch, driven from a spare buffered leg of the trigger"
		(at 400.05 576.5799999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "1333c4c6-ffb9-415c-816a-b9fce5c84138")
	)
	(text "buffer already placed there, per spec Sec.9.8's own instruction not to"
		(at 400.05 581.66 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e64cf104-b1a1-44c6-9d08-d98aaf21cbf7")
	)
	(text "load the barcode net itself.)"
