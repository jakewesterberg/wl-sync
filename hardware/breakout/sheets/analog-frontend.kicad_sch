	(text "already puts 2 pins on it (SENSE=OUTPUT / filter R+C midpoint / SK follower"
		(at 240.03 40.64 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8643b9e3-8f4b-4edd-b116-369571ef62ed")
	)
	(text "feedback), so kicad-cli sch erc's isolated_pin_label check does not fire here"
