	)
	(text "sensor (not on this board, like the mic/accelerometer/joystick) -- cathode on"
		(exclude_from_sim no)
		(at 240.03 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "08195e2f-fa2e-4b66-8528-cf82495145ca")
	)
	(text "amplifier turns the disturbance into common mode instead. This is what lets the"
		(exclude_from_sim no)
		(at 240.03 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0af3ed5f-893d-4682-b412-4c4e101965c1")
	)
	(text "inputs additionally accept +-10V via switchable /1//2 attenuation, on BOTH legs"
		(exclude_from_sim no)
		(at 240.03 325.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1313ab4c-e6dc-471c-a487-2bb846b3a4c2")
	)
	(text "WHY DIFFERENTIAL (spec Sec.5.6): the rig sits in a Faraday cage sound booth."
		(exclude_from_sim no)
		(at 240.03 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "16cf128a-dca5-4d99-a174-ba2119796931")
	)
	(text "only signal, through a BNC shield. Whether the bulkhead bonds that shield to the"
		(exclude_from_sim no)
		(at 240.03 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1823291c-9008-4051-8e06-511f7945a086")
	)
	(text "shield disturbance uncancelled in /2 mode). Each leg (signal = clamp node,"
		(exclude_from_sim no)
		(at 240.03 335.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1ba9a500-8a56-4b2f-80ce-2003ffd9a211")
	)
	(text "So every front end senses centre against shield AT THE CONNECTOR and a difference"
		(exclude_from_sim no)
		(at 240.03 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1f4dd361-498c-4b96-8ffe-1a866ab71672")
	)
	(text "derivation); unit 4 = spare, tied off ('+' to AGND, unity-gain follower)."
