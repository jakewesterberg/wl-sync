	(text "Control / USB-I2C (Task 12) -- an on-board MCP2221A USB-I2C bridge, on the"
		(at 279.4 20.32 0)
		(effects (font (size 1.27 1.27)))
		(uuid "7a07dbc1-ec35-4127-a049-e0d7abb6da4f")
	)
	(text "internal 4-pin USB header pi-interface.kicad_sch (Task 9) already placed, driving"
		(at 279.4 25.4 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ca1d7412-24b6-46f0-a567-0aef99eff48e")
	)
	(text "an I2C bus that carries two MCP23017 16-bit GPIO expanders (32 outputs -> the 32"
		(at 279.4 30.48 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6b2b97ea-368d-441b-95ba-5c6d46b77abc")
	)
	(text "mux address lines MUX1_A0..MUX8_A3, mux-intan.kicad_sch/Task 10c -- exact fit, no"
		(at 279.4 35.56 0)
		(effects (font (size 1.27 1.27)))
		(uuid "68553433-5518-4cd3-bfe7-8af7a94059ad")
	)
	(text "spares) and the MCP4728 quad DAC (comparators.kicad_sch/Task 10d, already placed"
		(at 279.4 40.64 0)
		(effects (font (size 1.27 1.27)))
		(uuid "2b103dd9-0238-4959-b9f6-5b5572d8681b")
	)
	(text "and powered -- this sheet only connects to it, does not duplicate it)."
		(at 279.4 45.72 0)
		(effects (font (size 1.27 1.27)))
		(uuid "8577d18d-00c5-418f-a89e-ed9cae74304b")
	)
	(text ""
		(at 279.4 50.8 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f30d18b7-b751-45cb-80aa-9158cffbce32")
	)
	(text "This chain hangs off USB, not GPIO: mux selection and DAC thresholds are"
		(at 279.4 55.88 0)
		(effects (font (size 1.27 1.27)))
		(uuid "44275ee4-ffa6-4f2b-b36b-2891898645e6")
	)
	(text "configuration-time state with no timing requirement, and the sync module's own"
		(at 279.4 60.96 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6a3492e9-d881-4746-b38e-2be126ac8097")
	)
	(text "40-pin header is already fully assigned regardless."
		(at 279.4 66.03999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "44b60146-e5d0-426f-b845-fa7e1532594c")
	)
	(text ""
		(at 279.4 71.12 0)
		(effects (font (size 1.27 1.27)))
		(uuid "690da5ae-49a7-43e8-9cf9-8df61242dbde")
	)
	(text "I2C ADDRESSES -- three devices, three distinct addresses, no collision:"
		(at 279.4 76.2 0)
		(effects (font (size 1.27 1.27)))
		(uuid "26c5bf95-a9bd-4cd9-97c3-b69055999a52")
	)
	(text "  MCP23017 #1: 0x20  (A2=A1=A0=0, all DGND) -> MUX1-4's A0-A3"
		(at 279.4 81.28 0)
		(effects (font (size 1.27 1.27)))
		(uuid "85e40616-e293-49ca-a180-fbc41bed22c2")
	)
	(text "  MCP23017 #2: 0x21  (A2=A1=0/DGND, A0=1/+3V3) -> MUX5-8's A0-A3"
		(at 279.4 86.36000000000001 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e89f56ce-09d7-4562-9dfe-19f0775228bb")
	)
	(text "  MCP4728:     0x60  (comparators.kicad_sch, Task 10d's own factory"
		(at 279.4 91.44 0)
		(effects (font (size 1.27 1.27)))
		(uuid "fd887e97-031e-4655-b2e8-c13b20d35afa")
	)
	(text "               default -- checked here, not re-derived, and confirmed distinct)"
		(at 279.4 96.52000000000001 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a039b57b-5777-4e84-ac4a-e82524137ffb")
	)
	(text "Also recorded in hardware/README.md for whoever writes the control software."
		(at 279.4 101.6 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f9f850f7-dae5-4731-b9ec-3344bb704d0b")
	)
	(text "GPIO-TO-MUX-ADDRESS-LINE MAP (this sheet's own declared, arbitrary-but-fixed"
		(at 279.4 110.49 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f183ba88-b1b0-40aa-a3dc-a7aaeb23ab18")
	)
	(text "convention -- no datasheet fixes this): each expander's own GPA0-3 drives its"
		(at 279.4 115.57 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ba5d8cd0-553a-4a9f-ac40-0276184dd65b")
	)
	(text "first mux's A0-A3, GPA4-7 the next mux's, GPB0-3 the next, GPB4-7 the last --"
		(at 279.4 120.64999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "86d09a89-3d92-4680-8285-00c95aafa903")
	)
	(text "16 pins, 4 muxes, exactly. Expander 1 (0x20): GPA0-3->MUX1_A0-3,"
		(at 279.4 125.72999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "0210776a-8208-4b99-9fc7-f624e7517e94")
	)
	(text "GPA4-7->MUX2_A0-3, GPB0-3->MUX3_A0-3, GPB4-7->MUX4_A0-3. Expander 2 (0x21): the"
		(at 279.4 130.81 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3c1cec62-6e8a-4987-9f23-e09940d87af5")
	)
	(text "same pattern shifted to MUX5-8. See mux-intan.kicad_sch / hardware/README.md's"
		(at 279.4 135.89 0)
		(effects (font (size 1.27 1.27)))
		(uuid "5d298fa3-26e7-4002-b63c-08e09df1f74c")
	)
	(text "own 'ADG1206 mux address truth table' for A3-A2-A1-A0=0000->S1 .. 1111->S16,"
		(at 279.4 140.97 0)
		(effects (font (size 1.27 1.27)))
		(uuid "321deabd-b9d6-4a5c-ad44-d406c684d74f")
	)
	(text "EN active-high (unchanged by this sheet -- still hardwired to +12V there)."
		(at 279.4 146.05 0)
		(effects (font (size 1.27 1.27)))
		(uuid "cdcd53bd-41c0-4ad1-8ffe-59e5ff1d0cd1")
	)
	(text "MCP2221A POWER MODE: 3.3V SELF-POWERED (Microchip DS20005565B Sec.1.6.2.3), NOT"
		(at 279.4 190.5 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6e248163-3322-4684-81f3-d6707ca576e9")
	)
	(text "USB bus-powered. VDD and VUSB both tie to +3V3 (this board's own existing rail,"
		(at 279.4 195.58 0)
		(effects (font (size 1.27 1.27)))
		(uuid "312f5524-d4c1-4f22-b282-1b7bd4f5209a")
	)
	(text "Task 7) -- the datasheet is explicit that VDD sets the GPIO/SDA/SCL logic-'1'"
		(at 279.4 200.66 0)
		(effects (font (size 1.27 1.27)))
		(uuid "41859392-8b80-452a-8770-9f255e137afa")
	)
	(text "level (Sec.1.6.2.1), and this bus's other two device classes (both MCP23017s"
		(at 279.4 205.74 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e57d1ae2-de6c-4b27-bb28-1d1ca5b1b94e")
	)
	(text "here, and comparators.kicad_sch's own MCP4728) already run at +3V3; powering the"
		(at 279.4 210.82 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4bdbe279-571b-47d6-91a9-2af4480ada5a")
	)
	(text "bridge from 5V USB_VBUS_PI would put a 5V-referenced driver on a 3.3V-expecting"
		(at 279.4 215.9 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c385609a-c09d-40a7-a812-ee599effbade")
	)
	(text "bus -- the same class of hazard this project's own destroy-hardware discipline"
		(at 279.4 220.98 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f4f6aead-49bf-49c2-8d2a-93a42050276f")
	)
	(text "(comparators.kicad_sch's +3V3-not-+5V pull-ups; pi-interface.kicad_sch's"
		(at 279.4 226.06 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f3c5473f-51cf-4460-881e-7b292d370b4f")
	)
	(text "RWD_DLVR level shift) exists to catch before silicon, not after."
		(at 279.4 231.14 0)
		(effects (font (size 1.27 1.27)))
		(uuid "5a0303a0-0805-4910-b7d8-67b6ca015222")
	)
	(text ""
		(at 279.4 236.22 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d790266b-ffb7-446e-aa71-58f17f70e8f6")
	)
	(text "USB_VBUS_PI (the internal header's own pin 1) IS DELIBERATELY LEFT UNCONNECTED"
		(at 279.4 241.3 0)
		(effects (font (size 1.27 1.27)))
		(uuid "e3c37da4-3b57-4386-8c2d-ecc1f5307718")
	)
	(text "on this sheet -- not an omission. 3.3V self-powered mode needs no VBUS"
		(at 279.4 246.38 0)
		(effects (font (size 1.27 1.27)))
		(uuid "646a7e84-d054-413c-9efc-41c249821b7c")
	)
	(text "connection at all (confirmed directly against the datasheet's own Figure 1-5,"
		(at 279.4 251.46 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3384178b-04be-4d0b-9e5f-37d3a3996d66")
	)
	(text "whose '5V (USB Bus)' arrow feeds only an external LDO's input, never a pin of"
		(at 279.4 256.54 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d602edbd-68ed-436c-a38d-7b162d857987")
	)
	(text "the part itself -- and this board already has its own +3V3, so it does not even"
		(at 279.4 261.62 0)
		(effects (font (size 1.27 1.27)))
		(uuid "54bce923-e8d5-411a-b75b-7dee92297074")
	)
	(text "need that LDO step). D+/D-/GND (the header's other 3 pins) all get real"
