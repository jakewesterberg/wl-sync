	(text "Intan mux bank (Task 10c) -- eight ADG1206YRUZ 16:1 analog multiplexers, each"
		(at 209.55 20.32 0)
		(effects (font (size 1.27 1.27)))
		(uuid "3bc17e74-812b-4df9-83ff-f97f2e420442")
	)
	(text "with ALL 16 A_* sources (Task 10a) on its own S1-S16 inputs, so any source can"
		(at 209.55 25.4 0)
		(effects (font (size 1.27 1.27)))
		(uuid "054c2f7e-00b1-4d59-a718-ca7edbb102bd")
	)
	(text "reach any of Intan's 8 channels. EN tied to +12V (active-high per Table 4,"
		(at 209.55 30.48 0)
		(effects (font (size 1.27 1.27)))
		(uuid "06dca9a3-01e8-49d8-9edf-163ab75d3ed9")
	)
	(text "always enabled -- selection is by address only). Each mux's own single D"
		(at 209.55 35.56 0)
		(effects (font (size 1.27 1.27)))
		(uuid "be0e901a-c1ea-4295-ac54-f0aa3c88ab04")
	)
	(text "output (pin 28, this part's own one common drain) feeds MUX_OUT{n} into one"
		(at 209.55 40.64 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6034489a-d368-4b1f-8dae-0f40d57e67e3")
	)
	(text "INA105KU difference amplifier -> 100R series -> BNC as INTAN_AO1..INTAN_AO8."
