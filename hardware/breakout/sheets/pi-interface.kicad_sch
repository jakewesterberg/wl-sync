	(text "RWD_DLVR level shift (added on this sheet, beyond the brief's own literal step"
		(at 15.24 219.71 0)
		(effects (font (size 1.27 1.27)))
		(uuid "35954ec8-90e2-494f-96b6-54716e11a12f")
	)
	(text "list -- see this generator's own module docstring for the full derivation):"
		(at 15.24 224.79000000000002 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ca5975b2-1d9f-45b2-a605-5e4fcfa59cce")
	)
	(text "RWD_DLVR is produced on taskpc-digital.kicad_sch by a 74HCT32 OR gate powered"
		(at 15.24 229.87 0)
		(effects (font (size 1.27 1.27)))
		(uuid "91acc217-0968-4a00-b957-efe28fc81e89")
	)
	(text "from +5V (place_reward_or_gate(), rail=\"+5V\") -- a genuine 0-5V logic signal."
		(at 15.24 234.95000000000002 0)
		(effects (font (size 1.27 1.27)))
		(uuid "6fd18d62-8027-4f68-81bf-d0199513e7f0")
	)
	(text "The sync module's GPIO is 3.3V and NOT 5V tolerant (plan.md's own global"
		(at 15.24 240.03 0)
		(effects (font (size 1.27 1.27)))
		(uuid "780ce3bc-3e0e-4557-9fc4-0ae6f341065b")
	)
	(text "constraint: '74LVC541A on 3.3V for inbound, 74HCT541 on 5V for outbound --"
		(at 15.24 245.11 0)
		(effects (font (size 1.27 1.27)))
		(uuid "986f2101-e0e9-4084-87ba-58b4a0154435")
	)
	(text "never one part for both'). So RWD_DLVR is wired through one more"
		(at 15.24 250.19 0)
		(effects (font (size 1.27 1.27)))
		(uuid "50435caa-0e3c-4a3c-93dc-344c18a3e059")
	)
	(text "SN74LVC541APW channel on +3V3 here -- the SAME level-shift-down recipe spec"
		(at 15.24 255.27 0)
		(effects (font (size 1.27 1.27)))
		(uuid "4f06fd24-78b3-4601-95a7-040b0049c6e5")
	)
	(text "Sec.7.1's own table already prescribes for 'Task PC (5V) -> Pi' -- rather than"
		(at 15.24 260.35 0)
		(effects (font (size 1.27 1.27)))
		(uuid "ce32f730-a1f1-4b0a-a4b0-2f32db8ad08f")
	)
	(text "straight to GPIO23, which would put ~5V on a 3.3V-only input."
		(at 15.24 265.43 0)
		(effects (font (size 1.27 1.27)))
		(uuid "7a8784bc-4772-4597-913c-c01402fcb95e")
	)
