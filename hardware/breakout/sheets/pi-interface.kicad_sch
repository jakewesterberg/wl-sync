	)
	(text "  26, 27    --    spare"
		(at 15.24 81.28 0)
		(effects (font (size 1.27 1.27)))
		(uuid "139dae90-fa47-47e2-a3db-4dd8b6f3b699")
	)
	(text "Why GPIO0-16 (not 2-18): PIO parallel capture reads a CONTIGUOUS pin range, and"
		(at 15.24 86.36 0)
		(effects (font (size 1.27 1.27)))
		(uuid "139251fb-ae24-46b7-aed3-bb78b40fb7e0")
	)
	(text "camera triggers must land on a hardware PWM pin (12, 13, 18, 19). Every 17-wide"
		(at 15.24 91.44 0)
		(effects (font (size 1.27 1.27)))
		(uuid "c3264169-2bbe-4643-a6da-69962eca15ee")
	)
	(text "contiguous window inside GPIO2-27 contains 12 and 13, and only the window"
		(at 15.24 96.52 0)
		(effects (font (size 1.27 1.27)))
		(uuid "9247998c-dc91-451e-9614-a9792388dfda")
	)
	(text "starting at 2 leaves even one PWM pin free -- insufficient for two triggers."
		(at 15.24 101.6 0)
		(effects (font (size 1.27 1.27)))
		(uuid "a716df6c-5141-4524-b176-5f3b2ff2a78c")
	)
	(text "Starting at 0 consumes 12 and 13 (ordinary data bits here) while leaving 18 and"
		(at 15.24 106.67999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "b0c650ae-316f-46c3-8e28-5e33996359ac")
	)
	(text "19 free for the two camera triggers."
		(at 15.24 111.75999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "75aaa7d3-118f-4a7b-8c42-94f91f5b2d3e")
	)
	(text "Module: a Compute Module 5 on its official IO Board as of this sheet"
		(at 15.24 116.83999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "aa5a601a-41e4-4fc8-a407-48ad68606f57")
	)
	(text "(conditional on floorplan, spec Sec.9.4) or a Raspberry Pi 5 -- identical"
		(at 15.24 121.92 0)
		(effects (font (size 1.27 1.27)))
		(uuid "463572b8-2515-4743-9225-94ecd8e7bce3")
	)
	(text "BCM2712/RP1, identical GPIO map/pinout either way; see hardware/README.md."
		(at 15.24 127.0 0)
		(effects (font (size 1.27 1.27)))
		(uuid "f9514e9e-1aef-4083-9d5a-56380f02d847")
	)
	(text "GPIO0/GPIO1 (physical header pins 27/28): the sync module probes these two pins"
		(at 15.24 129.54 0)
		(effects (font (size 1.27 1.27)))
		(uuid "afacc62e-3f23-4f87-8fbd-99f4790f40e8")
	)
	(text "as I2C at boot, looking for a HAT ID EEPROM. The 330R series resistors above"
		(at 15.24 134.62 0)
		(effects (font (size 1.27 1.27)))
		(uuid "124e3fd3-ef31-4335-b6ec-ca51a9870bcb")
	)
	(text "limit contention between that probe and this board's own buffered drive."
		(at 15.24 139.7 0)
		(effects (font (size 1.27 1.27)))
		(uuid "d262c755-d823-456b-af03-f9e28a488a1d")
	)
	(text "Requires force_eeprom_read=0 in config.txt (spec Sec.4) -- a config.txt setting,"
		(at 15.24 144.78 0)
		(effects (font (size 1.27 1.27)))
		(uuid "538c48ba-aa21-43a1-ae8c-a6ceddabe8c6")
	)
	(text "not something this schematic can enforce."
		(at 15.24 149.85999999999999 0)
		(effects (font (size 1.27 1.27)))
		(uuid "fdc273d5-76aa-43e3-acd5-82d41a29be87")
	)
