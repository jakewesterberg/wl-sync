(version 1)
# Generated by hardware/gen/gen_breakout_pcb.py from hardware/breakout/constraints.md §4.
# Net-class membership, default widths and the default clearance are in
# breakout.kicad_pro. KiCad treats a net class's width as what the router draws,
# not as a minimum DRC enforces, so the minimums are stated here (V-2).

# ---- track widths --------------------------------------------------------------
# N-8: 0.2 mm is the floor for every net.
(rule "N-8 default track width"
  (condition "A.Type == 'Track'")
  (constraint track_width (min 0.2mm)))
(rule "N-7 ANALOG track width"
  (condition "A.Type == 'Track' && A.NetClass == 'ANALOG'")
  (constraint track_width (min 0.25mm)))
(rule "N-6 RAIL_BRANCH track width"
  (condition "A.Type == 'Track' && A.NetClass == 'RAIL_BRANCH'")
  (constraint track_width (min 0.4mm)))
(rule "N-5 ISO_PWR track width"
  (condition "A.Type == 'Track' && A.NetClass == 'ISO_PWR'")
  (constraint track_width (min 0.5mm)))
(rule "N-4 NI_PWR track width"
  (condition "A.Type == 'Track' && A.NetClass == 'NI_PWR'")
  (constraint track_width (min 0.6mm)))
(rule "N-2 INLET_N12 track width"
  (condition "A.Type == 'Track' && A.NetClass == 'INLET_N12'")
  (constraint track_width (min 0.8mm)))
(rule "N-3 FAN track width"
  (condition "A.Type == 'Track' && A.NetClass == 'FAN'")
  (constraint track_width (min 0.8mm)))
(rule "N-1 INLET track width"
  (condition "A.Type == 'Track' && A.NetClass == 'INLET'")
  (constraint track_width (min 1.0mm)))
# S-5: 0.15 mm only where a package forces it -- inside the courtyards of the three
# fine-pitch parts, where a track leaving a 0.35 or 0.5 mm pad cannot be wider.
(rule "S-5 U55 escape track width"
  (condition "A.Type == 'Track' && A.intersectsCourtyard('U55')")
  (constraint track_width (min 0.15mm)))
(rule "S-5 U3 escape track width"
  (condition "A.Type == 'Track' && A.intersectsCourtyard('U3')")
  (constraint track_width (min 0.15mm)))
(rule "S-5 U4 escape track width"
  (condition "A.Type == 'Track' && A.intersectsCourtyard('U4')")
  (constraint track_width (min 0.15mm)))

# ---- clearances ----------------------------------------------------------------
# N-12: about 33 V between the raw +15 V and -15 V nets; IPC-2221 Table 6-1 B2.
(rule "N-12 raw 15 V pair, outer layers"
  (layer outer)
  (condition "(A.NetName == 'ISO_P15_RAW' || A.NetName == 'ISO_P15_FILT') && (B.NetName == 'ISO_N15_RAW' || B.NetName == 'ISO_N15_FILT')")
  (constraint clearance (min 0.6mm)))

# N-13 (as amended 2026-11-21): 0.6 mm on outer layers from any net that reaches a
# panel connector to any other net. The list is every such net in the netlist,
# grounds and rails excepted.
(rule "N-13 panel-side nets, outer layers"
  (layer outer)
  (condition "A.Net != B.Net && (A.NetName == 'ACCESIO_AGND' || A.NetName == 'ACCESIO_SHELL' || A.NetName == 'ACC_TRIG_TPC' || A.NetName == 'AO_GND_TPC' || A.NetName == 'AO_L_BNC' || A.NetName == 'AO_L_TPC' || A.NetName == 'AO_R_BNC' || A.NetName == 'AO_R_TPC' || A.NetName == 'A_ACC_NI' || A.NetName == 'A_ACC_RAW' || A.NetName == 'A_ACC_SHLD' || A.NetName == 'A_AMB_NI' || A.NetName == 'A_AMB_RAW' || A.NetName == 'A_AMB_SHLD' || A.NetName == 'A_EYE_LP_DAC' || A.NetName == 'A_EYE_LP_NI' || A.NetName == 'A_EYE_LX_DAC' || A.NetName == 'A_EYE_LX_NI' || A.NetName == 'A_EYE_LX_TPC' || A.NetName == 'A_EYE_LY_DAC' || A.NetName == 'A_EYE_LY_NI' || A.NetName == 'A_EYE_LY_TPC' || A.NetName == 'A_EYE_RP_DAC' || A.NetName == 'A_EYE_RP_NI' || A.NetName == 'A_EYE_RX_DAC' || A.NetName == 'A_EYE_RX_NI' || A.NetName == 'A_EYE_RX_TPC' || A.NetName == 'A_EYE_RY_DAC' || A.NetName == 'A_EYE_RY_NI' || A.NetName == 'A_EYE_RY_TPC' || A.NetName == 'A_JOY_X_NI' || A.NetName == 'A_JOY_X_RAW' || A.NetName == 'A_JOY_X_SHLD' || A.NetName == 'A_JOY_X_TPC' || A.NetName == 'A_JOY_Y_NI' || A.NetName == 'A_JOY_Y_RAW' || A.NetName == 'A_JOY_Y_SHLD' || A.NetName == 'A_JOY_Y_TPC' || A.NetName == 'A_MIC_NI' || A.NetName == 'A_MIC_RAW' || A.NetName == 'A_MIC_SHLD' || A.NetName == 'A_MISC1_NI' || A.NetName == 'A_MISC1_RAW' || A.NetName == 'A_MISC1_SHLD' || A.NetName == 'A_MISC1_TPC' || A.NetName == 'A_MISC2_NI' || A.NetName == 'A_MISC2_RAW' || A.NetName == 'A_MISC2_SHLD' || A.NetName == 'A_MISC2_TPC' || A.NetName == 'A_MISC3_NI' || A.NetName == 'A_MISC3_RAW' || A.NetName == 'A_MISC3_SHLD' || A.NetName == 'A_MISC3_TPC' || A.NetName == 'A_PD1_NI' || A.NetName == 'A_PD1_RAW' || A.NetName == 'A_PD1_SHLD' || A.NetName == 'A_PD2_NI' || A.NetName == 'A_PD2_RAW' || A.NetName == 'A_PD2_SHLD' || A.NetName == 'BARCODE_INTAN_BNC' || A.NetName == 'BARCODE_NI' || A.NetName == 'CAM_FRAME_BEH_BNC' || A.NetName == 'CAM_FRAME_EYE_BNC' || A.NetName == 'CAM_SYNC_BEH1' || A.NetName == 'CAM_SYNC_BEH2' || A.NetName == 'CAM_SYNC_BEH3' || A.NetName == 'CAM_SYNC_BEH4' || A.NetName == 'CAM_SYNC_EYE' || A.NetName == 'EVT_D0_NI' || A.NetName == 'EVT_D0_TPC' || A.NetName == 'EVT_D1_NI' || A.NetName == 'EVT_D1_TPC' || A.NetName == 'EVT_D2_NI' || A.NetName == 'EVT_D2_TPC' || A.NetName == 'EVT_D3_NI' || A.NetName == 'EVT_D3_TPC' || A.NetName == 'EVT_D4_NI' || A.NetName == 'EVT_D4_TPC' || A.NetName == 'EVT_D5_NI' || A.NetName == 'EVT_D5_TPC' || A.NetName == 'EVT_D6_NI' || A.NetName == 'EVT_D6_TPC' || A.NetName == 'EVT_D7_NI' || A.NetName == 'EVT_D7_TPC' || A.NetName == 'EVT_D8_NI' || A.NetName == 'EVT_D8_TPC' || A.NetName == 'EVT_D9_NI' || A.NetName == 'EVT_D9_TPC' || A.NetName == 'EVT_D10_NI' || A.NetName == 'EVT_D10_TPC' || A.NetName == 'EVT_D11_NI' || A.NetName == 'EVT_D11_TPC' || A.NetName == 'EVT_D12_NI' || A.NetName == 'EVT_D12_TPC' || A.NetName == 'EVT_D13_NI' || A.NetName == 'EVT_D13_TPC' || A.NetName == 'EVT_D14_NI' || A.NetName == 'EVT_D14_TPC' || A.NetName == 'EVT_D15_NI' || A.NetName == 'EVT_D15_TPC' || A.NetName == 'EVT_STROBE_INTAN_BNC' || A.NetName == 'EVT_STROBE_NI' || A.NetName == 'EVT_STROBE_TPC' || A.NetName == 'INTAN_AO1' || A.NetName == 'INTAN_AO2' || A.NetName == 'INTAN_AO3' || A.NetName == 'INTAN_AO4' || A.NetName == 'INTAN_AO5' || A.NetName == 'INTAN_AO6' || A.NetName == 'INTAN_AO7' || A.NetName == 'INTAN_AO8' || A.NetName == 'PD1_COMP_NI' || A.NetName == 'PD1_COMP_PFI' || A.NetName == 'PD1_COMP_TPC' || A.NetName == 'PD2_COMP_NI' || A.NetName == 'PD2_COMP_TPC' || A.NetName == 'RHS_STIM_BNC' || A.NetName == 'RHS_STIM_OUT_NI' || A.NetName == 'RHS_STIM_OUT_TPC' || A.NetName == 'RWD_BTN' || A.NetName == 'RWD_CMD_INTAN_BNC' || A.NetName == 'RWD_CMD_NI' || A.NetName == 'RWD_CMD_TPC' || A.NetName == 'RWD_DLVR_BNC' || A.NetName == 'RWD_DLVR_INTAN_BNC' || A.NetName == 'RWD_DLVR_NI' || A.NetName == 'STIM_TRIG_INTAN_BNC' || A.NetName == 'STIM_TRIG_NI' || A.NetName == 'STIM_TRIG_TPC')")
  (constraint clearance (min 0.6mm)))
# N-13's one exemption: U11's own pads, 0.2 mm apart at 0.65 mm pitch.
(rule "N-13 exemption, U11 own pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U11') && B.memberOfFootprint('U11')")
  (constraint clearance (min 0.2mm)))

# S-5: 0.15 mm, used only where a package forces it. Three packages do: U55's
# MSOP-10 (0.35 mm pads at 0.5 mm pitch) and the HVSSOP-8 of U3 and U4 (0.5 mm
# pads at 0.65 mm pitch). Each rule covers that part's own pads and nothing else.
(rule "S-5 U55 own pad gap"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U55') && B.memberOfFootprint('U55')")
  (constraint clearance (min 0.15mm)))
(rule "S-5 U3 own pad gap"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U3') && B.memberOfFootprint('U3')")
  (constraint clearance (min 0.15mm)))
(rule "S-5 U4 own pad gap"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('U4') && B.memberOfFootprint('U4')")
  (constraint clearance (min 0.15mm)))
